# Copy to .env and replace the value before using scripts/start_dashboard.ps1.
# The real .env is ignored by git.
CRAZY_AUDIOBOOK_DASHBOARD_TOKEN=replace-with-a-long-random-token
GOOGLE_BOOKS_API_KEY=
# Google AI Studio key used for Gemini API triage/adjudication. Google One's
# Gemini web subscription does not provide this key automatically.
GEMINI_API_KEY=
