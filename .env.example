# Copy to .env and replace the value before using scripts/start_dashboard.ps1.
# The real .env is ignored by git.
CRAZY_AUDIOBOOK_DASHBOARD_TOKEN=replace-with-a-long-random-token
# Token for the local Voice service. Optional for the supported loopback setup;
# required if the Voice service ever binds beyond loopback. When set, mirror the
# same value into `voice_server.api_token` in brain/config.yaml so the Brain can
# authenticate to it.
CRAZY_AUDIOBOOK_VOICE_TOKEN=
GOOGLE_BOOKS_API_KEY=
# Google AI Studio key used for Gemini API triage/adjudication. Google One's
# Gemini web subscription does not provide this key automatically.
GEMINI_API_KEY=

# NAS 24/7 Storage & Streaming Configuration
NAS_SSH_HOST=192.168.50.180
NAS_SSH_USER=crazywiz
NAS_SSH_PASSWORD=
NAS_SSH_PORT=22
NAS_REMOTE_ROOT=/mnt/nas/media/crazybooks

# Home Assistant Push Notifications
HA_BASE_URL=http://192.168.50.194:8123
HA_API_TOKEN=
HA_NOTIFY_SERVICE=crazywiz_notification_group
DASHBOARD_PUBLIC_URL=https://crazyha.mywire.org/audiobook/
